{
  "name": "migration-platform-metadata-schema",
  "version": "2.0.0",
  "description": "PostgreSQL DDL for the platform metadata store. Primary keys use table-specific names (e.g. migration_job_id).",
  "target": {
    "engine": "postgresql",
    "min_version": "14",
    "recommended_version": "16",
    "database": "migration_checklist",
    "docker_service": "postgres_checklist",
    "default_port": 5555
  },
  "connection": {
    "env_var": "METADATA_DB_URL",
    "example": "postgresql+asyncpg://postgres:postgres@localhost:5555/migration_checklist"
  },
  "orm": "infrastructure/metadata_db/models.py",
  "primary_key_convention": {
    "auth_users": "auth_user_id",
    "auth_sessions": "auth_session_id",
    "project_connections": "project_connection_id",
    "project_projects": "project_id",
    "migration_jobs": "migration_job_id",
    "migration_table_plans": "migration_table_plan_id",
    "migration_commands": "migration_job_id",
    "migration_quarantine": "migration_quarantine_id",
    "validation_runs": "validation_run_id",
    "validation_mismatches": "validation_mismatch_id",
    "audit_log": "audit_log_id",
    "auth_token_denylist": "jti",
    "cutover_checkpoints": "cutover_checkpoint_id",
    "replication_streams": "replication_stream_id",
    "migration_programs": "migration_program_id",
    "migration_waves": "migration_wave_id"
  },
  "scripts": [
    {
      "file": "postgres/000_create_database.sql",
      "purpose": "Create the migration_checklist database",
      "depends_on": []
    },
    {
      "file": "postgres/001_metadata_schema.sql",
      "purpose": "Full metadata schema (all 16 tables, current head)",
      "depends_on": ["postgres/000_create_database.sql"],
      "tables": [
        "project_connections",
        "auth_users",
        "auth_sessions",
        "auth_token_denylist",
        "project_projects",
        "migration_jobs",
        "migration_table_plans",
        "migration_commands",
        "migration_quarantine",
        "validation_runs",
        "validation_mismatches",
        "audit_log",
        "cutover_checkpoints",
        "replication_streams",
        "migration_programs",
        "migration_waves"
      ]
    }
  ],
  "author": "Migration Platform Team",
  "copyright": "Copyright (c) 2026 Ravi Sharma",
  "license": "SPDX-License-Identifier: MIT"
}
