# SQL Optima Migration installer — generated on first run. Do not commit this file.
# Recreate by deleting .env and re-running sql-optima.ps1 / sql-optima.sh

SQLOPTIMA_VERSION=0.2.1
SQLOPTIMA_IMAGE_REGISTRY=ghcr.io/rsharma155

MIGRATION_MASTER_KEY=
MIGRATION_JWT_SECRET=
METADATA_DB_PASSWORD=

MIGRATION_EDITION=enterprise
MIGRATION_LICENSE_KEY=DEV-LOCAL
MIGRATION_ENV=on-prem
ENVIRONMENT=development
